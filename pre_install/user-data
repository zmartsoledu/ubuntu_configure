#cloud-config
autoinstall:
  version: 1
  
  # Minimal interaction
  interactive-sections: []
  
  # Early commands before anything else
  early-commands:
    - systemctl stop ssh
  
  # Locale and keyboard
  locale: en_GB.UTF-8
  keyboard:
    layout: uk
    variant: ''
  
  # Network - use ethernet during install, will switch to NetworkManager later
  network:
    version: 2
    ethernets:
      any:
        match:
          name: "en*"
        dhcp4: true
        dhcp6: false
        optional: true
  
  # Storage - LUKS encrypted root
  storage:
    layout:
      name: lvm
      sizing-policy: all
      password: "ubuntu"  # Default LUKS passphrase, change in post-install
    swap:
      size: 0  # No swap, or set to desired size
  
  # Identity - will be replaced in first boot
  identity:
    hostname: ubuntu-server-zmart
    username: zadmin
    password: "$6$rounds=4096$saltsalt$hDLfVW8p8A9RLzCqFNhiaqPeZLPcXpUr0lCUcqZMYflWpx3zWpLuXBQUxqE2Z2m3KdYuJK1t3aT5lHOLqL3Ex/"  # "ubuntu"
  
  # SSH - enable only during install for debugging
  ssh:
    install-server: true
    allow-pw: true
  
  # Packages - absolute minimum for base server
  packages:
    - curl
    - wget
    - vim
    - git
    - openssh-server
    - build-essential
    - linux-headers-generic
    - cryptsetup
    - cryptsetup-initramfs
  
  # Snap - we'll remove it later, but need it for now
  snaps:
    - name: core20
      channel: stable
  
  # Late commands - prepare for post-install
  late-commands:
    # Point /bin/sh to bash
    - curtin in-target --target=/target -- ln -sf /bin/bash /bin/sh
    
    # Copy post-install scripts to target
    - mkdir -p /target/root/post_install
    
    # Disable snap socket to prevent auto-refresh during setup
    - curtin in-target --target=/target -- systemctl mask snapd.socket snapd.service
    
    # Copy post-install notes onto the new system, if present on the media
    - '[ -f /cdrom/nocloud/post_install_instructions.txt ] && cp /cdrom/nocloud/post_install_instructions.txt /target/root/ubuntu_configure_next_steps.txt || true'
    
    # Create flag file for first boot detection
    - touch /target/root/.first_boot_pending
    
    # Set up SSH to be disabled after first login
    - echo "systemctl disable --now ssh" > /target/root/.ssh_disable_pending
  
  # User data completion
  user-data:
    disable_root: false
    timezone: Europe/London
    package_update: false
    package_upgrade: false
    
  # Reboot after install
  shutdown: reboot
